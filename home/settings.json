{
  "env": {
    "AWS_DEFAULT_REGION": "us-east-1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:svelte.dev)",
      "WebFetch(domain:vuejs.org)",
      "WebFetch(domain:developer.atlassian.com)",
      "Skill(update-config)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git config --get:*)",
      "Bash(go:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(egrep:*)",
      "Bash(fgrep:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(wc:*)",
      "Bash(gh:*)",
      "Bash(aws:*)",
      "Bash(cdk:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(golangci-lint:*)",
      "Bash(for:*)",
      "Bash(cd:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(jq:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(printf:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(true:*)",
      "Bash(test:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git apply:*)",
      "Bash(git worktree:*)",
      "Bash(git tag:*)",
      "Bash(git am:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials)"
    ]
  },
  "skillOverrides": {
    "security": "name-only",
    "observability": "name-only",
    "cicd": "name-only",
    "coding-principles": "name-only",
    "tech-stack": "name-only",
    "go": "name-only",
    "python": "name-only",
    "typescript": "name-only",
    "svelte": "name-only",
    "vue": "name-only",
    "cdk": "name-only",
    "uiux": "name-only",
    "database": "name-only",
    "docs": "name-only",
    "sdlc": "name-only",
    "backlog": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/git_guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/comment_guard.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/comment_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/comment_guard.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "light",
  "agentPushNotifEnabled": true,
  "model": "opus"
}
