#!/usr/bin/env bash
#
# pre-commit-comments - runs the comment guard over staged files.
#
# Install (per repo):  git config core.hooksPath .githooks
#                      then copy or symlink this file to .githooks/pre-commit
#
# Exit 0:  no staged file adds a comment
# Exit 1:  at least one does; the offending lines are printed
#
# This is the same comment_guard.py the Claude hook uses, so an edit
# made in any editor by any tool hits the identical rule. It compares
# the staged blob against HEAD, per file.
#
# Override the guard location with COMMENT_GUARD=/path/to/guard.py.
# A missing guard fails the commit rather than passing silently.
set -uo pipefail

GUARD="${COMMENT_GUARD:-$HOME/.claude/hooks/comment_guard.py}"

if [ ! -f "$GUARD" ]; then
  echo "pre-commit: comment guard not found at $GUARD" >&2
  echo "pre-commit: refusing to commit without the check. Set COMMENT_GUARD or run setup.sh." >&2
  exit 1
fi

STAGED="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$STAGED" ] && exit 0

FAILED=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  [ -f "$file" ] || continue

  OUTPUT="$(
    OLD="$(git show ":0:$file" 2>/dev/null || true)" \
    HEADVER="$(git show "HEAD:$file" 2>/dev/null || true)" \
    FILE="$file" python3 -c '
import json, os, subprocess, sys

payload = {
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
        "file_path": os.environ["FILE"],
        "old_string": os.environ.get("HEADVER", ""),
        "new_string": os.environ.get("OLD", ""),
    },
}
result = subprocess.run(
    ["python3", sys.argv[1]], input=json.dumps(payload), capture_output=True, text=True
)
if not result.stdout.strip():
    sys.exit(0)
decision = json.loads(result.stdout)["hookSpecificOutput"]
if decision["permissionDecision"] == "deny":
    print(decision["permissionDecisionReason"])
    sys.exit(1)
sys.exit(0)
' "$GUARD"
  )"

  if [ -n "$OUTPUT" ]; then
    printf '%s\n\n' "$OUTPUT" >&2
    FAILED=1
  fi
done <<< "$STAGED"

if [ "$FAILED" -ne 0 ]; then
  echo "pre-commit: blocked. Remove the new comment(s) above and re-stage." >&2
  exit 1
fi
exit 0
