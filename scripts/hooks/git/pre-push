#!/usr/bin/env bash
#
# pre-push - dispatcher. Runs every pre-push-* sibling in this directory.
#
# Install (per repo):  bash scripts/hooks/git/install.sh /path/to/repo
#
# Pre-push carries the slow checks: full-module lint, vet, build. They
# are too slow to run per commit but cheap next to a red CI run.
#
# Skip one check:  SKIP=golangci git push ...     (comma-separated suffixes)
# Skip all:        git push --no-verify
set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKIP="${SKIP:-}"
FAILED=0

STDIN_REFS="$(cat)"

for check in "$HOOK_DIR"/pre-push-*; do
  [ -x "$check" ] || continue
  name="$(basename "$check")"
  suffix="${name#pre-push-}"

  case ",$SKIP," in
    *",$suffix,"*) printf 'pre-push: skipped %s\n' "$suffix" >&2; continue ;;
  esac

  printf '%s' "$STDIN_REFS" | "$check" "$@" || FAILED=1
done

exit "$FAILED"
