#!/usr/bin/env bash
#
# pre-commit-gofmt - fails when a staged Go file is not gofmt-clean.
#
# Checks and reports; it never rewrites or re-stages your files. A hook
# that runs `gofmt -w` on a partially staged file silently pulls the
# unstaged remainder into the commit, so this one refuses to write.
#
# Fix what it reports with:  gofmt -w <files>
set -uo pipefail

command -v gofmt >/dev/null 2>&1 || {
  printf 'pre-commit-gofmt: gofmt not found on PATH\n' >&2
  exit 1
}

AUTOFIX="${GOFMT_AUTOFIX:-1}"

STAGED="$(git diff --cached --name-only --diff-filter=ACM -- '*.go')"
[ -z "$STAGED" ] && exit 0

FIXABLE=()
PARTIAL=()

while IFS= read -r file; do
  [ -z "$file" ] && continue
  [ -f "$file" ] || continue
  [ -n "$(git show ":0:$file" | gofmt -l /dev/stdin 2>/dev/null)" ] || continue

  if [ -n "$(git diff --name-only -- "$file")" ]; then
    PARTIAL+=("$file")
  else
    FIXABLE+=("$file")
  fi
done <<< "$STAGED"

if [ "$AUTOFIX" != "0" ] && [ "${#FIXABLE[@]}" -gt 0 ]; then
  if gofmt -w "${FIXABLE[@]}" && git add -- "${FIXABLE[@]}"; then
    printf 'pre-commit-gofmt: formatted and re-staged:\n' >&2
    printf '  %s\n' "${FIXABLE[@]}" >&2
    FIXABLE=()
  fi
fi

if [ "${#FIXABLE[@]}" -eq 0 ] && [ "${#PARTIAL[@]}" -eq 0 ]; then
  exit 0
fi

if [ "${#PARTIAL[@]}" -gt 0 ]; then
  printf 'pre-commit-gofmt: not gofmt-clean, left alone because they also have unstaged changes:\n' >&2
  printf '  %s\n' "${PARTIAL[@]}" >&2
  printf 'Stage the whole file, or run: gofmt -w %s && git add %s\n' "${PARTIAL[*]}" "${PARTIAL[*]}" >&2
fi

if [ "${#FIXABLE[@]}" -gt 0 ]; then
  printf 'pre-commit-gofmt: staged files are not gofmt-clean:\n' >&2
  printf '  %s\n' "${FIXABLE[@]}" >&2
  printf 'Fix with: gofmt -w %s\n' "${FIXABLE[*]}" >&2
fi

exit 1
