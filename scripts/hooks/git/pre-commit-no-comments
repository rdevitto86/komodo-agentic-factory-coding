#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
RULES="$SCRIPT_DIR/../../lib/comment-rules.awk"
[ -f "$RULES" ] || exit 0

FOUND=0

while IFS= read -r FILE; do
  [ -f "$FILE" ] || continue

  case "$FILE" in
    *.go|*.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.svelte|*.c|*.h|*.cc|*.cpp|*.hpp|*.rs|*.java|*.kt|*.scala|*.swift)
      FAMILY="cfamily" ;;
    *.py|*.sh|*.bash|*.zsh|*.rb)
      FAMILY="hash" ;;
    *)
      continue ;;
  esac

  MARKED_STREAM=$(git diff --cached -U3 -- "$FILE" | awk '
    /^@@/ { print "R\t"; next }
    /^(\+\+\+|---|diff |index )/ { next }
    /^\+/ { print "A\t" substr($0, 2); next }
    /^-/ { next }
    /^ / { print "C\t" substr($0, 2); next }
  ')
  [ -z "$MARKED_STREAM" ] && continue

  VIOLATIONS=$(printf '%s\n' "$MARKED_STREAM" | FAMILY="$FAMILY" MARKED=1 awk -f "$RULES")

  if [ -n "$VIOLATIONS" ]; then
    echo "BLOCKED: staged changes to $FILE violate standards/comments.md."
    echo "$VIOLATIONS"
    echo ""
    FOUND=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$FOUND" -ne 0 ]; then
  echo "Allowed: function/method docs up to 2 sentences, sparse single-line"
  echo "inline notes, machine directives, test banners. Banned: declaration"
  echo "comments (type/struct/field/var/const), file or package headers,"
  echo "multi-line prose blocks. Fix the staged lines and retry."
  exit 1
fi
exit 0
