#!/usr/bin/env bash
#
# pre-push-verify - runs a repo's own verify gate, if it has one.
#
# Resolves the same order verify_gate.py does: .claude/verify.py, then
# scripts/verify.py, then .claude/verify.sh, then a verify: target in a
# Makefile, a Taskfile, or a justfile. None of them at the repo root
# means this repo doesn't opt in to a push-time check; exits 0.
# Mirrors pre-push-golangci's presence-gated pattern so one shared hook
# directory serves every repo without per-repo branching in the
# dispatcher.
#
# The one deliberate deviation: verify_gate.py requires an executable
# bit on .claude/verify.sh, this accepts a plain file, because a
# Windows checkout does not carry one and git dispatches this hook
# through its own bundled shell either way.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

for candidate in "$REPO_ROOT/.claude/verify.py" "$REPO_ROOT/scripts/verify.py"; do
  [ -f "$candidate" ] || continue
  python3 "$candidate" || {
    printf '\npre-push-verify: %s failed. Fix the issues above or push with --no-verify.\n' "$candidate" >&2
    exit 1
  }
  exit 0
done

VERIFY="$REPO_ROOT/.claude/verify.sh"
if [ -f "$VERIFY" ]; then
  bash "$VERIFY" || {
    printf '\npre-push-verify: %s failed. Fix the issues above or push with --no-verify.\n' "$VERIFY" >&2
    exit 1
  }
  exit 0
fi

# A build-tool target is matched the way verify_gate.py matches it: a line
# starting with the target name, which is a Taskfile's two-space indent and
# column zero everywhere else.
run_target() {
  runner="$1"
  label="$2"
  command -v "$runner" >/dev/null 2>&1 || {
    printf 'pre-push-verify: %s declares a verify target but %s is not on PATH\n' "$REPO_ROOT" "$runner" >&2
    exit 1
  }
  ( cd "$REPO_ROOT" && "$runner" verify ) || {
    printf '\npre-push-verify: %s failed. Fix the issues above or push with --no-verify.\n' "$label" >&2
    exit 1
  }
  exit 0
}

if [ -f "$REPO_ROOT/Makefile" ] && grep -q '^verify:' "$REPO_ROOT/Makefile"; then
  run_target make "make verify"
fi

for taskfile in "$REPO_ROOT/Taskfile.yml" "$REPO_ROOT/Taskfile.yaml"; do
  if [ -f "$taskfile" ] && grep -q '^  verify:' "$taskfile"; then
    run_target task "task verify"
  fi
done

if [ -f "$REPO_ROOT/justfile" ] && grep -q '^verify:' "$REPO_ROOT/justfile"; then
  run_target just "just verify"
fi

exit 0
