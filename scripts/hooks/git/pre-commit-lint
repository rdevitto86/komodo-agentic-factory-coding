#!/usr/bin/env bash

set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
LINT_FAILED=0

GO_DIRS=()
TS_ROOTS=()

while IFS= read -r FILE; do
  [ -f "$FILE" ] || continue

  if [[ "$FILE" == *.go ]]; then
    GO_DIRS+=("$(dirname "$FILE")")
  elif [[ "$FILE" == *.ts || "$FILE" == *.tsx || "$FILE" == *.svelte ]]; then
    DIR="$ROOT/$(dirname "$FILE")"
    TSCONFIG=""
    while [[ "$DIR" != "$ROOT" && "$DIR" != "/" ]]; do
      if [[ -f "$DIR/tsconfig.json" ]]; then
        TSCONFIG="$DIR/tsconfig.json"
        break
      fi
      DIR=$(dirname "$DIR")
    done
    if [[ -z "$TSCONFIG" && -f "$ROOT/tsconfig.json" ]]; then
      TSCONFIG="$ROOT/tsconfig.json"
    fi
    [ -n "$TSCONFIG" ] && TS_ROOTS+=("$(dirname "$TSCONFIG")")
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "${#GO_DIRS[@]}" -gt 0 ] && command -v golangci-lint &> /dev/null; then
  while IFS= read -r PKG_DIR; do
    echo "→ lint: $PKG_DIR"
    golangci-lint run --fast "$ROOT/$PKG_DIR/..." 2>&1 | tail -40 || LINT_FAILED=1
  done < <(printf '%s\n' "${GO_DIRS[@]}" | sort -u)
fi

if [ "${#TS_ROOTS[@]}" -gt 0 ] && command -v tsc &> /dev/null; then
  while IFS= read -r TSROOT; do
    echo "→ tsc: $TSROOT"
    (cd "$TSROOT" && tsc --noEmit) 2>&1 | tail -40 || LINT_FAILED=1
  done < <(printf '%s\n' "${TS_ROOTS[@]}" | sort -u)
fi

if [ "$LINT_FAILED" -ne 0 ]; then
  echo "Lint failed — fix the issues above before committing."
  exit 1
fi
exit 0
