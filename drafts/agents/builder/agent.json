{
  "weight": "standard",
  "chain": ["claude-cli:sonnet", "anthropic-api:sonnet", "http:local"],
  "tools": ["read", "search", "edit", "write", "run", "skill"],
  "run_classes": ["build", "test", "lint", "format"],
  "guard": ["B1"],
  "limits": { "wall_min": 30, "idle_min": 10, "retries": 2 },
  "skills": {
    "allow": ["standards-*"],
    "always": ["standards-comments"]
  },
  "slots": {
    "required": ["repo_profile", "group", "tasks", "files", "file_contents"],
    "optional": ["repo_context", "standards", "specs", "diff", "checks", "findings", "scope_answer"]
  },
  "result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tasks"],
    "properties": {
      "tasks": {
        "description": "One entry per task in the brief, every task ID exactly once, in brief order.",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status", "checks"],
          "properties": {
            "id": { "description": "The task ID from the brief.", "type": "string", "enum": ["{{task_ids}}"] },
            "status": {
              "description": "done: every done_when command exited 0. needs_scope: you need a file not under 'Files you may change'. blocked: you cannot finish; give the code.",
              "type": "string",
              "enum": ["done", "needs_scope", "blocked"]
            },
            "checks": {
              "description": "Each done_when command you ran, with its exit code.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command", "exit"],
                "properties": { "command": { "type": "string" }, "exit": { "type": "integer" } }
              }
            },
            "scope_paths": { "description": "needs_scope only: the paths you need.", "type": "array", "items": { "type": "string" } },
            "code": {
              "description": "blocked only: why.",
              "type": "string",
              "enum": ["check_fails_twice", "missing_fact", "depends_on_blocked", "sandbox_denied", "other"]
            },
            "facts": { "description": "blocked only: the command, path or task ID behind the code.", "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "summary": { "description": "Internal: what you changed and why, for a resumed session. No person reads it.", "type": "string" }
    }
  }
}
