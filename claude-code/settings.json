{
  "env": {
    "AWS_DEFAULT_REGION": "us-east-1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:svelte.dev)",
      "WebFetch(domain:vuejs.org)",
      "WebFetch(domain:developer.atlassian.com)",
      "Skill(update-config)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git config --get:*)",
      "Bash(go:*)",
      "Bash(bun:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(tsc:*)",
      "Bash(curl:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(egrep:*)",
      "Bash(fgrep:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(gh:*)",
      "Bash(aws:*)",
      "Bash(cdk:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(golangci-lint:*)",
      "Bash(for:*)",
      "Bash(cd:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(jq:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tee:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(printf:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(true:*)",
      "Bash(test:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git apply:*)",
      "Bash(git worktree:*)",
      "Bash(git tag:*)",
      "Bash(git am:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials)"
    ]
  },
  "model": "sonnet",
  "skillOverrides": {
    "config-accessibility-output": "name-only",
    "rules-commenting": "name-only",
    "rules-source-control": "name-only",
    "standards-worklog": "name-only",
    "standards-security": "name-only",
    "standards-observability": "name-only",
    "standards-cicd": "name-only",
    "standards-c": "name-only",
    "standards-go": "name-only",
    "standards-python": "name-only",
    "standards-typescript": "name-only",
    "standards-svelte": "name-only",
    "standards-vue": "name-only",
    "standards-cdk": "name-only",
    "standards-uiux": "name-only",
    "standards-database": "name-only",
    "standards-docker": "name-only",
    "standards-docs": "name-only",
    "generate-prd": "name-only",
    "generate-sdd": "name-only",
    "generate-changelog": "name-only",
    "standards-sdlc": "name-only",
    "generate-adr": "name-only",
    "generate-runbook": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/git_guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/comment_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/context_injector.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/verify_gate.py"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "auto",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  }
}
