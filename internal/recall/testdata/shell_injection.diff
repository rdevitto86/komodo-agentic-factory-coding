diff --git a/internal/history/author.go b/internal/history/author.go
new file mode 100644
--- /dev/null
+++ b/internal/history/author.go
@@ -0,0 +1,17 @@
+package history
+
+import (
+	"os/exec"
+	"strings"
+)
+
+// ByAuthor lists the one-line commit subjects an author wrote in the repo at dir.
+func ByAuthor(dir, author string) ([]string, error) {
+	cmd := exec.Command("sh", "-c", "git log --oneline --author="+author)
+	cmd.Dir = dir
+	out, err := cmd.Output()
+	if err != nil {
+		return nil, err
+	}
+	return strings.Split(strings.TrimSpace(string(out)), "\n"), nil
+}
