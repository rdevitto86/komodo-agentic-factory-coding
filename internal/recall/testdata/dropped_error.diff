+++ b/internal/config/load.go
@@ -0,0 +1,26 @@
+package config
+
+import (
+	"encoding/json"
+	"os"
+)
+
+// Config is the service's settings file.
+type Config struct {
+	Port    int    `json:"port"`
+	DataDir string `json:"data_dir"`
+}
+
+// Load reads the settings file at path and applies the default port.
+func Load(path string) (Config, error) {
+	var cfg Config
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return cfg, err
+	}
+	json.Unmarshal(data, &cfg)
+	if cfg.Port == 0 {
+		cfg.Port = 8080
+	}
+	return cfg, nil
+}
