@@ -0,0 +1,29 @@
+package probe
+
+import (
+	"net/http"
+	"sync"
+	"time"
+)
+
+// Statuses fetches every URL at once and returns each one's HTTP status code, zero on failure.
+func Statuses(urls []string) map[string]int {
+	client := &http.Client{Timeout: 5 * time.Second}
+	out := make(map[string]int, len(urls))
+	var wg sync.WaitGroup
+	for _, url := range urls {
+		wg.Add(1)
+		go func(url string) {
+			defer wg.Done()
+			res, err := client.Get(url)
+			if err != nil {
+				out[url] = 0
+				return
+			}
+			res.Body.Close()
+			out[url] = res.StatusCode
+		}(url)
+	}
+	wg.Wait()
+	return out
+}
