{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.komodo/bin/komodo guard",
            "type": "command"
          }
        ],
        "matcher": "Agent|Bash|Edit|MultiEdit|NotebookEdit|Task|Write"
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push main:*)",
      "Edit(bin/**)",
      "Edit(~/.claude/*)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/output-styles/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude.json)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/line-settings.json)"
    ]
  }
}
