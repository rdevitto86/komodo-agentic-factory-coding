#!/bin/sh
# Git runs this through its bundled shell on every platform; it prefers the compiled binary and falls back to Python.
d=$(dirname "$0")
case "$(uname -s 2>/dev/null)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*|Windows*) os=windows ;;
  *) os= ;;
esac
case "$(uname -m 2>/dev/null)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) arch= ;;
esac
if [ -n "$os" ] && [ -n "$arch" ]; then
  b="$d/bin/komodo-hooks-$os-$arch"
  [ "$os" = windows ] && b="$b.exe"
  if [ -x "$b" ]; then exec "$b" prepush "$@"; fi
fi
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1; then
    if [ "$p" = py ]; then exec py -3 "$d/pre-push.py" "$@"; fi
    exec "$p" "$d/pre-push.py" "$@"
  fi
done
echo "pre-push: no compiled binary and no python interpreter found" >&2
exit 1
