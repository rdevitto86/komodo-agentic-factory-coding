{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:pkg.go.dev)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git worktree list:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(python3 -m komodo:*)",
      "Bash(python -m komodo:*)",
      "Bash(python3 scripts/verify.py)",
      "Bash(python3 -m unittest:*)",
      "Bash(go:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(npx tsc:*)",
      "Bash(make:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh label list:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(jq:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(date:*)",
      "Bash(printf:*)",
      "Bash(test:*)"
    ],
    "deny": [
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git update-ref:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(rm *)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.claude/.credentials.json)",
      "Edit(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/context_injector.py"
          }
        ]
      }
    ]
  }
}
