{
  "critical_refs": ["main", "master"],
  "config_paths": [
    "~/.claude/**",
    "~/.claude.json",
    "~/.codex/**",
    "~/.komodo/**",
    "**/.git/config",
    "**/.git/hooks/**",
    "bin/**"
  ],
  "trailer_patterns": [
    "(?i)co-authored[-]by\\s*:",
    "(?i)generated[ ]with",
    "(?i)generated[ ]by",
    "\\x{1F916}"
  ]
}
