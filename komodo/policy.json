{
  "critical_refs": ["main", "master"],
  "config_paths": [
    "~/.komodo/**",
    "**/.git/config",
    "**/.git/hooks/**",
    "bin/**",
    ".komodo/policy.json",
    "komodo/policy.json"
  ],
  "trailer_patterns": [
    "(?im)^co-authored-by\\s*[:=]",
    "(?im)^generated[ -]with\\s*[:=]",
    "(?im)^generated[ -]by\\s*[:=]",
    "\\x{1F916}"
  ]
}
