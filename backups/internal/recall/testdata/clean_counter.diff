diff --git a/internal/metrics/counter.go b/internal/metrics/counter.go
--- a/internal/metrics/counter.go
+++ b/internal/metrics/counter.go
@@ -1,7 +1,10 @@
 package metrics

-// Counter counts events by name.
+import "sync"
+
+// Counter counts events by name and is safe for concurrent use.
 type Counter struct {
+	mu     sync.Mutex
 	counts map[string]int
 }

@@ -9,3 +12,17 @@ type Counter struct {
 func NewCounter() *Counter {
 	return &Counter{counts: map[string]int{}}
 }
+
+// Add records one event under name.
+func (c *Counter) Add(name string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.counts[name]++
+}
+
+// Count returns how many events name has recorded.
+func (c *Counter) Count(name string) int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.counts[name]
+}
