diff --git a/internal/page/window.go b/internal/page/window.go
new file mode 100644
--- /dev/null
+++ b/internal/page/window.go
@@ -0,0 +1,18 @@
+package page
+
+// Window returns the items on page number page, size items per page, counting pages from zero.
+func Window(items []string, page, size int) []string {
+	start := page * size
+	if start >= len(items) {
+		return nil
+	}
+	end := start + size
+	if end > len(items) {
+		end = len(items)
+	}
+	out := make([]string, 0, size)
+	for i := start; i <= end; i++ {
+		out = append(out, items[i])
+	}
+	return out
+}
