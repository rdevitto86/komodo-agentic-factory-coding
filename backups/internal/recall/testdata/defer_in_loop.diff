@@ -0,0 +1,26 @@
+package digest
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"os"
+)
+
+// Sums returns the SHA-256 of every path, keyed by path.
+func Sums(paths []string) (map[string]string, error) {
+	out := make(map[string]string, len(paths))
+	for _, path := range paths {
+		file, err := os.Open(path)
+		if err != nil {
+			return nil, err
+		}
+		defer file.Close()
+		hash := sha256.New()
+		if _, err := io.Copy(hash, file); err != nil {
+			return nil, err
+		}
+		out[path] = hex.EncodeToString(hash.Sum(nil))
+	}
+	return out, nil
+}
