+++ b/internal/files/serve.go
@@ -0,0 +1,24 @@
+package files
+
+import (
+	"net/http"
+	"os"
+	"path/filepath"
+)
+
+// Handler serves uploaded files from root by the name query parameter.
+type Handler struct {
+	Root string
+}
+
+// ServeHTTP writes the named file's bytes, or 404 when it does not exist.
+func (h Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	name := r.URL.Query().Get("name")
+	data, err := os.ReadFile(filepath.Join(h.Root, name))
+	if err != nil {
+		http.NotFound(w, r)
+		return
+	}
+	w.Header().Set("Content-Type", "application/octet-stream")
+	_, _ = w.Write(data)
+}
